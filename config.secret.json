{
  "// WARNING": "NEVER COMMIT THIS FILE TO GIT - IT CONTAINS REAL API KEYS",
  "// Instructions": [
    "1. This file is listed in .gitignore to prevent accidental commits",
    "2. Copy config.example.json to config.secret.json",
    "3. Fill in your actual API keys below",
    "4. The config loader will automatically use this file if it exists"
  ],
  
  "api_keys": {
    "openai": {
      "api_key": "sk-...",
      "organization_id": null,
      "enabled": true
    },
    
    "senso": {
      "api_key": "your-senso-api-key",
      "base_url": "https://sdk.senso.ai/api/v1",
      "enabled": false
    },
    
    "airia": {
      "token": "your-airia-token",
      "base_url": "https://api.airia.ai/v1",
      "enabled": false
    },
    
    "intercom": {
      "app_id": "your-workspace-id",
      "access_token": "your-access-token",
      "api_base": "https://api.intercom.io",
      "identity_verification_secret": null,
      "enabled": false
    },
    
    "stripe": {
      "secret_key": "sk_test_...",
      "publishable_key": "pk_test_...",
      "webhook_secret": "whsec_...",
      "enabled": false
    },
    
    "twilio": {
      "account_sid": "AC...",
      "auth_token": "your-auth-token",
      "phone_number": "+1234567890",
      "messaging_service_sid": null,
      "enabled": false
    },
    
    "segment": {
      "write_key": "your-write-key",
      "enabled": false
    },
    
    "sentry": {
      "dsn": "https://key@org.ingest.sentry.io/project",
      "environment": "development",
      "enabled": false
    },
    
    "elevenlabs": {
      "api_key": "your-api-key",
      "voice_id": "Rachel",
      "model_id": "eleven_monolingual_v1",
      "enabled": false
    },
    
    "snowflake": {
      "user": "your-username",
      "password": "your-password",
      "account": "account.region",
      "warehouse": "COMPUTE_WH",
      "database": "DEMO_DB",
      "schema": "PUBLIC",
      "role": "SYSADMIN",
      "enabled": false
    },
    
    "redpanda": {
      "brokers": "localhost:9092",
      "topic": "events.demo",
      "sasl_username": null,
      "sasl_password": null,
      "enabled": false
    },
    
    "truefoundry": {
      "endpoint": "https://your-control-plane.truefoundry.com/api/llm",
      "token": "your-token",
      "enabled": false
    }
  },
  
  "environments": {
    "development": {
      "debug": true,
      "log_level": "DEBUG",
      "use_sandbox": true
    },
    "staging": {
      "debug": false,
      "log_level": "INFO",
      "use_sandbox": true
    },
    "production": {
      "debug": false,
      "log_level": "WARNING",
      "use_sandbox": false
    }
  },
  
  "current_environment": "development"
}